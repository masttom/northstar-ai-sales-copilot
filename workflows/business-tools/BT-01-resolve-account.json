    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    account_id,\n    account_name,\n    segment,\n    account_tier,\n    sales_territory\nFROM accounts\nWHERE\n    account_id ILIKE $1\n    OR account_name ILIKE '%' || $1 || '%'\nORDER BY\n    CASE\n        WHEN LOWER(account_id) = LOWER($1) THEN 0\n        WHEN LOWER(account_name) = LOWER($1) THEN 1\n        ELSE 2\n    END,\n    account_name ASC;",
