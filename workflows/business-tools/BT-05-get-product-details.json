        "operation": "executeQuery",
        "query": "SELECT\n    product_id,\n    sku,\n    product_name,\n    brand,\n    category,\n    product_family,\n    product_role,\n    lifecycle_status,\n    commercial_status,\n    list_price_idr,\n    launch_date,\n    discontinued_date\nFROM products\nWHERE product_id = $1;",
