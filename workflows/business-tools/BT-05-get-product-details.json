      "name": "Get Product Details from PostgreSQL",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "name": "POSTGRES_CREDENTIAL_PLACEHOLDER"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(item => item.json);\n\nconst requestedId = $('When Executed by Another Workflow').first().json.product_id.trim();\n\nconst productRow = rows.find(row => row.product_id);\n\n// Product not found\nif (!productRow) {\n  return [{\n    json: {\n      product_id: requestedId,\n      found: false,\n      product: null\n    }\n  }];\n}\n\n// PostgreSQL DATE -> YYYY-MM-DD\nconst toDate = value =>\n  value == null ? null : String(value).slice(0, 10);\n\nreturn [{\n  json: {\n    product_id: requestedId,\n    found: true,\n    product: {\n      product_id: productRow.product_id,\n      sku: productRow.sku,\n      product_name: productRow.product_name,\n      brand: productRow.brand,\n      category: productRow.category,\n      product_family: productRow.product_family,\n      product_role: productRow.product_role,\n      lifecycle_status: productRow.lifecycle_status,\n      commercial_status: productRow.commercial_status,\n      list_price_idr: productRow.list_price_idr,\n      launch_date: toDate(productRow.launch_date),\n      discontinued_date: toDate(productRow.discontinued_date)\n    }\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
